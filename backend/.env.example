# Copy to backend/.env and fill in. Never commit .env.

# Supabase project (Settings > API). The service role key bypasses RLS:
# keep it on the server only, never in the Mac app.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Jev via OpenRouter (https://openrouter.ai/keys). Empty = simple topic-overlap fallback.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Muse Spark via Meta Model API. Empty key = template intros.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=

# Matching
MATCH_THRESHOLD=0.7
INTERRUPT_THRESHOLD=0.5
MATCH_INTERVAL_SEC=20
