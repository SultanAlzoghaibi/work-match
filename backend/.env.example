# Copy to backend/.env for local runs (never commit .env). On Render, set
# these in the dashboard instead.

# Supabase > Connect > Direct > Session pooler > URI. URL-encode special
# characters in the password (@ becomes %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Jev via OpenRouter (https://openrouter.ai/keys). Empty = topic-overlap fallback.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

MATCH_THRESHOLD=0.7
INTERRUPT_THRESHOLD=0.5
