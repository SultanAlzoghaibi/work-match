{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "work-match",
  "version": "0.1.0",
  "identifier": "com.sultanalzoghaibi.workmatch",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "work-match",
        "width": 760,
        "height": 560,
        "minWidth": 560,
        "minHeight": 440,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1c1c1e",
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "match",
        "title": "work-match match",
        "width": 340,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "url": "match.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/llama-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:work_match.db"
      ]
    }
  }
}
