{
  "manifest_version": 3,
  "name": "work-match capture",
  "version": "0.1.0",
  "description": "Sends the readable text of your active tab to the work-match app running on this computer.",
  "key": "",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed"
}
